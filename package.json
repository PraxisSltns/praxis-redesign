{
  "name": "praxis-redesign",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node server/index.mjs",
    "dev:api": "node --env-file-if-exists=.env server/index.mjs",
    "test": "vitest run",
    "e2e": "node e2e/scenarios.mjs",
    "photos:check": "vitest run src/config",
    "dev:up": "docker compose up -d --wait --build",
    "dev:down": "docker compose down",
    "dev:reset": "docker compose down -v && docker compose up -d --wait --build",
    "db:migrate": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js -m server/db/migrations --migration-file-language sql --check-order up",
    "db:seed": "node --env-file-if-exists=.env server/retailers/cli.mjs --fixtures",
    "db:migrate:down": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js -m server/db/migrations --migration-file-language sql --check-order down",
    "db:migrate:create": "node node_modules/node-pg-migrate/bin/node-pg-migrate.js -m server/db/migrations --migration-file-language sql create",
    "retailers:import": "node --env-file-if-exists=.env server/retailers/cli.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.0",
    "lucide-react": "^0.462.0",
    "motion": "^13.4.4",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.1",
    "redis": "^5.12.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.21",
    "axe-core": "^4.10.3",
    "playwright-core": "^1.56.1",
    "postcss": "^8.5.6",
    "serve": "^14.2.4",
    "tailwindcss": "^3.4.17",
    "three": "^0.180.0",
    "typescript": "^5.8.3",
    "vite": "^5.4.19",
    "vitest": "^3.2.4"
  }
}
