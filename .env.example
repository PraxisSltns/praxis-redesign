# Local settings for the gateway (server/index.mjs) and the page (Vite). Copy to .env and adjust:
#   cp .env.example .env
# .env is git-ignored. Never commit a real key. Keys stay on the server: never put a secret in a
# VITE_ variable, because those are compiled into the JavaScript every visitor downloads.
# The defaults below match docker-compose.yml (npm run dev:up).

# ---- Gateway --------------------------------------------------------------------------------
PORT=3000
# Origins allowed to call /api from another site (server/cors.mjs). The Vite dev server:
CORS_ORIGINS=http://localhost:5173

# ---- Local dependencies (docker-compose.yml) -------------------------------------------------
POSTGRES_USER=praxis
POSTGRES_PASSWORD=praxis
POSTGRES_DB=praxis
POSTGRES_PORT=5433
DATABASE_URL=postgres://praxis:praxis@localhost:5433/praxis

# Pool and timeouts (server/db.mjs); these are the defaults.
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_MS=15000
DB_IDLE_TIMEOUT_MS=30000

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=5000

# S3-compatible storage (SeaweedFS locally, a Railway bucket on staging)
S3_ENDPOINT=http://localhost:8333
S3_PORT=8333
S3_REGION=us-east-1
S3_BUCKET=praxis-local
S3_ACCESS_KEY_ID=praxis
S3_SECRET_ACCESS_KEY=praxis-local-secret
S3_FORCE_PATH_STYLE=true

# ---- The ai service (services/ai; docker-compose.yml runs it on :8000) ----------------------
# On Railway: http://ai.railway.internal:8000 (private network, no public address).
AI_SERVICE_URL=http://localhost:8000
AI_PORT=8000

# ---- AI (paid AI stays off; see docs/AI-HANDOVER.md) -----------------------------------------
# Which provider answers a service, for example AI_PROVIDER_STYLING_EXPLANATION=off. Unset: none.
# AI_PROVIDER_<SERVICE>=
ALLOW_BILLABLE_AI=false
ALLOW_BILLABLE_IMAGES=false
TRYON_PROVIDER=
# A Google AI Studio key switches on the free writer AND the budgeted outfit pictures
# (server/ai.mjs APPROVED_DEFAULTS). Leave empty locally unless you mean to use them.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_IMAGE_MODEL=
GEMINI_CHECK_MODEL=
# Tests only: points the Gemini providers at a stand-in server.
GEMINI_API_BASE=

# ---- Outfit pictures (server/visuals.mjs) ----------------------------------------------------
OUTFIT_IMAGE_BUDGET_USD=20
OUTFIT_IMAGE_DAILY_USD=6
VISUALIZATION_DAILY_CAP=20
VISUALIZATION_ADDRESS_DAILY_CAP=30
# Where pictures are kept. Unset: the system temp folder (or the Railway volume when mounted).
VISUALS_DIR=
VISUAL_PHOTO_HOSTS=

# ---- Test store (server/providers/shopify-feed.mjs) ------------------------------------------
# A store's address switches on product_matching for ?stock=live tabs. Empty: off.
RETAIL_SHOPIFY_STORE=
RETAIL_SHOPIFY_NAME=
RETAIL_SHOPIFY_FOR=test

# ---- Page build (Vite reads these from .env too) ---------------------------------------------
# Where the gateway is. Empty: the page's own origin (npm start serves both on :3000).
# For npm run dev (page on :5173) against a local gateway, set http://localhost:3000. Vite reads .env
# for builds too, so clear it again before npm run build or the build will call localhost.
VITE_API_BASE_URL=
VITE_RECOMMENDATION_ADAPTER=mock
VITE_AI_PROVIDERS=
VITE_TRYON_ADAPTER=mock
VITE_ALLOW_BILLABLE_IMAGES=false
# Shows /internal/analytics in a build (it is always on in npm run dev).
VITE_INTERNAL_PAGE=false
